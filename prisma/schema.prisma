
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum Role {
  ADMIN
  SUB_ADMIN
  MEMBER
}

enum ProjectStatus {
  IDLE
  ACTIVE
  PAUSED
  CLOSED
}

enum CardMovementMode {
  FREE
  FORWARD_ONLY
}



model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(MEMBER)
  
  // Email Verification
  isEmailVerified  Boolean   @default(false)
  emailOtp         String?
  emailOtpExpires  DateTime?
  
  // Password Reset
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectMemberships ProjectMembership[]
  orgMemberships     OrganizationMembership[]
  createdProjects    Project[]               @relation("ProjectCreator")
  createdOrgs        Organization[]          @relation("OrgCreator")
  assignedCards      Card[]                  @relation("CardAssignee")
  refreshTokens      RefreshToken[]
}



model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  createdBy User                     @relation("OrgCreator", fields: [createdById], references: [id])
  members   OrganizationMembership[]
  projects  Project[]
}


model OrganizationMembership {
  userId    String
  orgId     String
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId]) // supports "members of org X" query
}



model Project {
  id               String           @id @default(cuid())
  name             String
  description      String?
  organizationId   String?
  creatorId        String
  status           ProjectStatus    @default(IDLE)
  cardMovementMode CardMovementMode @default(FREE)
  // Lifecycle timing: startedAt marks when work began.
  // pausedAt marks when the CURRENT pause started (null when not paused).
  // totalPausedMs accumulates all completed pause durations.
  // closedAt removed — derivable: status=CLOSED + updatedAt.
  startedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  creator      User               @relation("ProjectCreator", fields: [creatorId], references: [id])
  members      ProjectMembership[]
  columns      Column[]
  labels       Label[]
  priorities   Priority[]
  cards        Card[]
  pauses       ProjectPause[]

  @@index([organizationId]) // primary query: projects in org X
  
}


model ProjectMembership {
  userId    String
  projectId String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId]) // supports "load all members of project X"
}



model Column {
  id        String   @id @default(cuid())
  name      String
  order     Int
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   Card[]
  cardTimes CardColumnTime[]

  // Unique on (projectId, order) enforces ordering integrity AND
  // doubles as the index for "load columns of project X ordered by order".
  @@unique([projectId, order])
}

model Card {
  id          String    @id @default(cuid())
  name        String
  description String?
  order       Int
  assigneeId  String?
  projectId   String
  columnId    String
  priorityId  String?
  // Replaces CardStatus enum + separate status field.
  // null = open; non-null = closed at that instant.
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignee  User?      @relation("CardAssignee", fields: [assigneeId], references: [id])
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column    Column     @relation(fields: [columnId], references: [id])
  priority  Priority?  @relation(fields: [priorityId], references: [id])
  labels    CardLabel[]
  columnTimes CardColumnTime[]
  holds     CardHold[]

  // Unique on (columnId, order) enforces ordering integrity (no two cards
  // share the same slot in a column) AND serves as the index for
  // "cards in column X ordered by order".
  @@unique([columnId, order])
  @@index([projectId])   // "all cards in project X" query
  @@index([assigneeId])  // "cards assigned to user X" query
  // Separate @@index([columnId]) removed — covered by the unique above.
  // Separate @@index([columnId, order]) removed — IS the unique above.
}

/// Explicit join table replaces Prisma's implicit m2m.
/// Composite PK = O(1) lookup + no extra unique index needed.
/// @@index([labelId]) enables "cards with label X" reverse lookup.
model CardLabel {
  cardId  String
  labelId String

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

// ── Time Tracking ────────────────────────────────────────────────────────────

model ProjectPause {
  projectId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, startedAt])
}

model CardColumnTime {
  cardId    String
  columnId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@id([cardId, startedAt])
  @@index([columnId])
}

model CardHold {
  cardId    String
  reason    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([cardId, startedAt])
}

// ── Metadata ─────────────────────────────────────────────────────────────────

model Label {
  id        String      @id @default(cuid())
  name      String
  color     String
  projectId String
  createdAt DateTime    @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   CardLabel[]

  @@index([projectId])
}

model Priority {
  id        String   @id @default(cuid())
  name      String
  weight    Int
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards   Card[]

  @@index([projectId])
}

// ── Auth ─────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
